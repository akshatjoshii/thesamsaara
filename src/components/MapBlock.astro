---
import Icon from './Icon.astro';
import site from '../data/site.json';
import { mapsEmbed, mapsDirections } from '../lib/links';
interface Props { showDistances?: boolean }
const { showDistances = true } = Astro.props;
---
<div class="grid gap-8 lg:grid-cols-5">
  <div class="lg:col-span-3 overflow-hidden rounded-xl ring-1 ring-black/5 bg-sand min-h-[320px]">
    <iframe
      title={`Map showing ${site.name}, Shivpuri`}
      src={mapsEmbed}
      class="h-full min-h-[320px] w-full border-0"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
  </div>
  <div class="lg:col-span-2">
    <p class="font-semibold text-teal-dark flex gap-2"><Icon name="pin" class="h-5 w-5 shrink-0 mt-0.5 text-amber" />{site.address.street}, {site.address.locality}, {site.address.region} {site.address.postalCode}</p>
    {showDistances && (
      <ul class="mt-5 divide-y divide-black/10 text-base">
        {site.distances.map((d) => (
          <li class="flex justify-between gap-4 py-2.5">
            <span>{d.from}</span>
            <span class="shrink-0 text-right text-charcoal/70">{d.distance}<br />{d.time}</span>
          </li>
        ))}
      </ul>
    )}
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={mapsDirections} class="btn btn-amber" target="_blank" rel="noopener">Get directions</a>
      <a href={site.googleProfile} class="btn btn-outline" target="_blank" rel="noopener">Open in Google Maps</a>
    </div>
    <p class="mt-4 text-sm text-charcoal/60">Distances and times are approximate and vary with traffic and season.</p>
  </div>
</div>
