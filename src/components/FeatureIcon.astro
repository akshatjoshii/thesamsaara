---
// Picks an icon that matches a feature's wording, so lists edited in the CMS
// get a fitting icon automatically. Falls back to a tick if nothing matches.
interface Props { text: string; class?: string }
const { text, class: cls = 'h-5 w-5' } = Astro.props;
const t = text.toLowerCase();

const rules: [RegExp, string][] = [
  [/tent|camp(ing)?\b/, 'tent'],
  [/kid|family/, 'users'],
  [/team/, 'users'],
  [/meal|catering|food|breakfast/, 'utensils'],
  [/bonfire|fire/, 'flame'],
  [/karaoke|music|sangeet|dj/, 'music'],
  [/confiden|leader/, 'flag'],
  [/raft|adventure|activit/, 'lifebuoy'],
  [/pool|swim/, 'pool'],
  [/park(ing)?\b/, 'parking'],
  [/wi-?fi/, 'wifi'],
  [/air-?condition|\bac\b/, 'snowflake'],
  [/caf[eé]|coffee|snack/, 'coffee'],
  [/game|volleyball|sport/, 'ball'],
  [/river|ganga|venue|beach/, 'waves'],
  [/d[eé]cor|interior|upgraded|best|premium/, 'sparkles'],
  [/shoot|photo|camera/, 'camera'],
  [/safe|secure|supervis/, 'shield'],
  [/pric|discount|budget|value/, 'tag'],
  [/outdoor|learning|nature|hill|trek/, 'mountain'],
  [/birthday|milestone|celebrat|party|cake/, 'cake'],
  [/bed|room|cottage|stay|guest/, 'bed'],
];
const name = rules.find(([re]) => re.test(t))?.[1] ?? 'check';
---
<svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'tent' && <><path d="M3.5 20 12 4l8.5 16" /><path d="M2 20h20" /><path d="M9 20l3-6 3 6" /></>}
  {name === 'utensils' && <><path d="M5 3v5a2 2 0 0 0 4 0V3" /><path d="M7 3v18" /><path d="M18 21V3c-2.2 1.2-3.5 4-3.5 7.5V14H18" /></>}
  {name === 'flame' && <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.07-2.14-.22-4.05 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.15.43-2.29 1-3a2.5 2.5 0 0 0 2.5 2.5z" />}
  {name === 'music' && <><path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" /></>}
  {name === 'lifebuoy' && <><circle cx="12" cy="12" r="9.5" /><circle cx="12" cy="12" r="4" /><path d="m5.3 5.3 3.9 3.9M14.8 14.8l3.9 3.9M14.8 9.2l3.9-3.9M9.2 14.8l-3.9 3.9" /></>}
  {name === 'pool' && <><path d="M8 3v11M16 3v11M8 7h8M8 11h8" /><path d="M2 18c1.7 0 1.7-1.2 3.3-1.2S7 18 8.7 18s1.7-1.2 3.3-1.2 1.7 1.2 3.3 1.2 1.7-1.2 3.4-1.2S20.3 18 22 18" /><path d="M2 21.5c1.7 0 1.7-1.2 3.3-1.2S7 21.5 8.7 21.5s1.7-1.2 3.3-1.2 1.7 1.2 3.3 1.2 1.7-1.2 3.4-1.2 1.6 1.2 3.3 1.2" /></>}
  {name === 'parking' && <><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M9.5 17V7h3.5a3 3 0 0 1 0 6H9.5" /></>}
  {name === 'wifi' && <><path d="M1.5 9a16 16 0 0 1 21 0" /><path d="M5 12.6a11 11 0 0 1 14 0" /><path d="M8.5 16.1a6 6 0 0 1 7 0" /><path d="M12 20h.01" stroke-width="2.5" /></>}
  {name === 'snowflake' && <><path d="M12 2v20M3.3 7l17.4 10M20.7 7 3.3 17" /><path d="m9.5 3.5 2.5 2 2.5-2M9.5 20.5l2.5-2 2.5 2" /></>}
  {name === 'coffee' && <><path d="M17 9h1a3.5 3.5 0 0 1 0 7h-1" /><path d="M3 9h14v7a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5z" /><path d="M7 2.5v3M10.5 2.5v3M14 2.5v3" /></>}
  {name === 'ball' && <><circle cx="12" cy="12" r="9.5" /><path d="M12 12V2.5M12 12l8.2 4.8M12 12l-8.2 4.8" /></>}
  {name === 'waves' && <><path d="M2 7c1.7 0 1.7-1.5 3.3-1.5S7 7 8.7 7s1.7-1.5 3.3-1.5S13.7 7 15.3 7s1.7-1.5 3.4-1.5S20.3 7 22 7" /><path d="M2 12.5c1.7 0 1.7-1.5 3.3-1.5s1.7 1.5 3.4 1.5 1.7-1.5 3.3-1.5 1.7 1.5 3.3 1.5 1.7-1.5 3.4-1.5 1.6 1.5 3.3 1.5" /><path d="M2 18c1.7 0 1.7-1.5 3.3-1.5S7 18 8.7 18s1.7-1.5 3.3-1.5 1.7 1.5 3.3 1.5 1.7-1.5 3.4-1.5S20.3 18 22 18" /></>}
  {name === 'sparkles' && <><path d="m12 3 1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z" /><path d="M19 3v4M17 5h4M5 17v4M3 19h4" /></>}
  {name === 'camera' && <><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3z" /><circle cx="12" cy="13" r="3.5" /></>}
  {name === 'shield' && <><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="m9 12 2 2 4-4" /></>}
  {name === 'users' && <><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></>}
  {name === 'tag' && <><path d="M12 2H2v10l9.3 9.3a1 1 0 0 0 1.4 0l8.6-8.6a1 1 0 0 0 0-1.4z" /><path d="M7 7h.01" stroke-width="2.5" /></>}
  {name === 'mountain' && <path d="m8 3 4 8 5-5 5 15H2z" />}
  {name === 'flag' && <><path d="M4 22V3" /><path d="M4 4c2.5-1.5 5-1.5 8 0s5.5 1.5 8 0v10c-2.5 1.5-5 1.5-8 0s-5.5-1.5-8 0" /></>}
  {name === 'cake' && <><path d="M20 21v-8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8" /><path d="M4 16s.5-1 2-1 2.5 2 4 2 2.5-2 4-2 2.5 2 4 2 2-1 2-1" /><path d="M2 21h20M7 8v3M12 8v3M17 8v3" /></>}
  {name === 'bed' && <><path d="M2 4v16M2 8h18a2 2 0 0 1 2 2v10M2 17h20M6 8v9" /></>}
  {name === 'check' && <path d="M20 6 9 17l-5-5" />}
</svg>
