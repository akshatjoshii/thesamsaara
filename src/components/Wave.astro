---
/**
 * River-current divider: a gently flowing edge in the next section's colour,
 * with thin "current" lines running along it like water past Shivpuri.
 * Place at the top of a section; `color` = that section's background.
 */
interface Props { color?: string; flip?: boolean; class?: string }
const { color = 'var(--color-sand-light)', flip = false, class: cls = '' } = Astro.props;
---
<div class:list={['pointer-events-none absolute inset-x-0 top-[2px] -translate-y-full leading-[0]', cls]} aria-hidden="true">
  <svg viewBox="0 0 1440 56" preserveAspectRatio="none" class:list={['block h-9 w-full sm:h-14', flip && '-scale-x-100']}>
    <path d="M0 56V34C180 22 320 18 520 26S900 46 1100 38 1340 20 1440 24V56Z" fill={color} />
    <path d="M0 34C180 22 320 18 520 26S900 46 1100 38 1340 20 1440 24" fill="none" stroke="var(--color-teal)" stroke-opacity=".55" stroke-width="1.5" vector-effect="non-scaling-stroke" />
    <path d="M0 44C200 34 360 31 560 37S920 54 1120 47 1350 32 1440 35" fill="none" stroke="var(--color-teal)" stroke-opacity=".25" stroke-width="1" vector-effect="non-scaling-stroke" />
  </svg>
</div>
