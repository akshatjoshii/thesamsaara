---
import Icon from './Icon.astro';
import reviews from '../data/reviews.json';
import site from '../data/site.json';

type Review = { name: string; rating: number; text: string; date?: string };
const items = reviews.items as Review[];
const { rating, count, show } = site.googleRating;
---
<div>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="eyebrow">Guest reviews</p>
      <h2 class="mt-2">What our guests say</h2>
    </div>
    {show && count > 0 && (
      <p class="flex items-center gap-2 text-lg font-semibold text-teal-dark">
        <Icon name="star" class="h-6 w-6 text-amber" /> {rating} on Google <span class="font-normal text-charcoal/70">({count} reviews)</span>
      </p>
    )}
  </div>

  {items.length > 0 ? (
    <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {items.map((r) => (
        <figure class="card reveal p-6">
          <div class="flex gap-0.5 text-amber" aria-label={`${r.rating} out of 5 stars`}>
            {Array.from({ length: r.rating }).map(() => <Icon name="star" class="h-4 w-4" />)}
          </div>
          <blockquote class="mt-3 text-charcoal/85">“{r.text}”</blockquote>
          <figcaption class="mt-4 text-sm font-semibold text-teal-dark">{r.name}{r.date && <span class="block font-normal text-charcoal/60">{r.date}</span>}</figcaption>
        </figure>
      ))}
    </div>
  ) : (
    <div class="mt-6 card p-6 sm:p-8">
      <p class="text-charcoal/80">Read honest reviews from guests who’ve stayed, camped and celebrated with us — and leave one after your stay.</p>
    </div>
  )}
  <a href={site.googleProfile} class="btn btn-outline mt-6" target="_blank" rel="noopener">Read our reviews on Google</a>
</div>
