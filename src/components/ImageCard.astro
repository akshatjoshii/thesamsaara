---
interface Props { href?: string; image: string; alt: string; title: string; text?: string; badge?: string; cta?: string }
const { href, image, alt, title, text, badge, cta = 'Explore' } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag href={href} class="group flex flex-col no-underline text-charcoal">
  <div class="relative aspect-[4/3] overflow-hidden rounded-xl bg-sand">
    <img src={image} alt={alt} loading="lazy" decoding="async" width="1200" height="800" class="h-full w-full object-cover" />
    {badge && <span class="absolute left-3 top-3 rounded-md bg-amber px-2.5 py-1 font-display text-sm font-semibold text-charcoal">{badge}</span>}
  </div>
  <div class="flex flex-1 flex-col pt-4">
    <h3 class="decoration-amber decoration-2 underline-offset-4 group-hover:underline">{title}</h3>
    {text && <p class="mt-2 flex-1 text-base text-charcoal/75">{text}</p>}
    <slot />
    {href && <span class="mt-3 font-display font-semibold text-teal">{cta}</span>}
  </div>
</Tag>
