---
import Icon from './Icon.astro';
import site from '../data/site.json';
import { waLink, telLink, formatINR } from '../lib/links';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image: string;
  imageAlt: string;
  waMessage?: string;
  showPrice?: boolean;
  crumbs?: { name: string; path: string }[];
  size?: 'full' | 'page';
  representative?: boolean;
}
const { eyebrow, title, subtitle, image, imageAlt, waMessage, showPrice = true, crumbs, size = 'page', representative = false } = Astro.props;
---
<section class:list={['relative isolate flex items-end overflow-hidden bg-teal-dark text-sand', size === 'full' ? 'min-h-[88svh]' : 'min-h-[62svh]']}>
  <img
    src={image}
    alt={imageAlt}
    class="hero-img absolute inset-0 -z-10 h-full w-full object-cover"
    fetchpriority="high"
    loading="eager"
    decoding="async"
    width="1920"
    height="1080"
  />
  <div class="absolute inset-0 -z-10 bg-linear-to-t from-charcoal/85 via-charcoal/45 to-charcoal/25"></div>
  <div class="absolute inset-0 -z-10 bg-linear-to-r from-charcoal/60 via-charcoal/20 to-transparent"></div>
  {size === 'full' && <div class="absolute inset-0 -z-10 bg-teal-dark/35"></div>}

  {representative && <span class="absolute bottom-3 right-4 z-10 text-[0.7rem] text-sand/60">Representative image</span>}
  <div class="container-x pb-16 pt-24 sm:pb-24">
    {crumbs && (
      <nav aria-label="Breadcrumb" class="mb-4 text-sm text-sand/80">
        <ol class="flex flex-wrap gap-1">
          <li><a href="/" class="text-sand/80">Home</a> /</li>
          {crumbs.map((c, i) => (
            <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <><a href={c.path} class="text-sand/80">{c.name}</a> /</>}</li>
          ))}
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow !text-amber">{eyebrow}</p>}
    <h1 class="mt-3 max-w-3xl !text-sand">{title}</h1>
    {subtitle && <p class="mt-5 max-w-2xl text-lg sm:text-xl text-sand/90">{subtitle}</p>}
    {showPrice && (
      <p class="mt-6 inline-flex flex-wrap items-baseline gap-x-2 rounded-2xl bg-white/10 px-4 py-2 backdrop-blur">
        <span class="text-sm uppercase tracking-wider text-sand/80">From</span>
        <span class="font-serif text-3xl font-semibold text-amber">{formatINR(site.startingPrice)}</span>
        <span class="text-sand/90">{site.priceNote}</span>
      </p>
    )}
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={waLink(waMessage)} class="btn btn-wa" target="_blank" rel="noopener" data-track="whatsapp_click"><Icon name="whatsapp" /> Get best price on WhatsApp</a>
      <a href={telLink} class="btn btn-light" data-track="call_click"><Icon name="phone" /> Call {site.phone}</a>
    </div>
  </div>
</section>

<script>
  // Gentle parallax on hero image (disabled for reduced motion)
  const img = document.querySelector<HTMLImageElement>('.hero-img');
  if (img && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = Math.min(window.scrollY, 800);
        img.style.transform = `translate3d(0, ${y * 0.25}px, 0) scale(1.05)`;
        ticking = false;
      });
    }, { passive: true });
  }
</script>
