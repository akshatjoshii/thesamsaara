---
import Icon from './Icon.astro';
interface Props { href?: string; image: string; alt: string; title: string; text?: string; badge?: string; cta?: string }
const { href, image, alt, title, text, badge, cta = 'Explore' } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag href={href} class="card reveal group flex flex-col no-underline text-charcoal transition hover:-translate-y-1 hover:shadow-lg">
  <div class="relative aspect-[4/3] overflow-hidden">
    <img src={image} alt={alt} loading="lazy" decoding="async" width="1200" height="800" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
    {badge && <span class="absolute left-4 top-4 rounded-full bg-amber px-3 py-1 text-xs font-semibold text-charcoal">{badge}</span>}
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="!text-xl">{title}</h3>
    {text && <p class="mt-2 flex-1 text-base text-charcoal/75">{text}</p>}
    <slot />
    {href && <span class="mt-4 inline-flex items-center gap-1 font-semibold text-teal">{cta} <Icon name="arrow" class="h-4 w-4 transition group-hover:translate-x-1" /></span>}
  </div>
</Tag>
