---
import type { Faq } from '../lib/schema';
interface Props { items: Faq[]; title?: string }
const { items, title = 'Frequently asked questions' } = Astro.props;
---
<div>
  {title && <h2 class="mb-6">{title}</h2>}
  <div class="divide-y divide-black/10 rounded-xl bg-white ring-1 ring-black/5">
    {items.map((f) => (
      <details class="group px-6 py-5">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-semibold text-teal-dark [&::-webkit-details-marker]:hidden">
          <span>{f.q}</span>
          <span class="mt-1 text-amber transition group-open:rotate-45 text-2xl leading-none" aria-hidden="true">+</span>
        </summary>
        <p class="mt-3 text-charcoal/80">{f.a}</p>
      </details>
    ))}
  </div>
</div>
