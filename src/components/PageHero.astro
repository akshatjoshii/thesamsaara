---
import Icon from './Icon.astro';
import site from '../data/site.json';
import { waLink, telLink, formatINR } from '../lib/links';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image: string;
  imageAlt: string;
  waMessage?: string;
  showPrice?: boolean;
  crumbs?: { name: string; path: string }[];
  size?: 'full' | 'page';
  representative?: boolean;
}
const { eyebrow, title, subtitle, image, imageAlt, waMessage, showPrice = true, crumbs, size = 'page', representative = false } = Astro.props;
---
<section class:list={['hero-in relative isolate flex items-end overflow-hidden bg-teal-dark text-sand-light', size === 'full' ? 'min-h-[90svh]' : 'min-h-[64svh]']}>
  <img
    src={image}
    alt={imageAlt}
    class="hero-img absolute inset-0 -z-10 h-full w-full object-cover"
    fetchpriority="high"
    loading="eager"
    decoding="async"
    width="1920"
    height="1080"
  />
  <!-- River-dusk wash: keeps the photo readable but recognisable -->
  <div class="absolute inset-0 -z-10 bg-linear-to-t from-teal-dark via-teal-dark/35 via-40% to-teal-dark/10"></div>
  <div class="absolute inset-0 -z-10 bg-linear-to-r from-teal-dark/85 via-teal-dark/45 via-45% to-transparent"></div>
  {size === 'full' && <div class="absolute inset-0 -z-10 bg-teal-dark/25"></div>}

  {representative && <span class="absolute right-4 top-3 z-10 text-[0.7rem] text-sand-light/70">Representative image</span>}

  <div class="container-x relative pb-20 pt-28 sm:pb-28">
    <div class="hero-copy">
      {crumbs && (
        <nav aria-label="Breadcrumb" class="mb-5 font-display text-sm text-sand-light/75">
          <ol class="flex flex-wrap gap-1.5">
            <li><a href="/" class="text-sand-light/75 no-underline hover:underline">Home</a> /</li>
            {crumbs.map((c, i) => (
              <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <><a href={c.path} class="text-sand-light/75 no-underline hover:underline">{c.name}</a> /</>}</li>
            ))}
          </ol>
        </nav>
      )}
      {eyebrow && <p class="eyebrow !text-amber">{eyebrow}</p>}
      <h1 class:list={['hero-title mt-3 !text-sand-light', size === 'full' ? 'max-w-4xl' : 'max-w-3xl']}>{title}</h1>
      {subtitle && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-sand-light/90 sm:text-xl">{subtitle}</p>}
      {showPrice && (
        <p class="mt-6 font-display text-sand-light/90">
          Stays from <span class="text-2xl font-bold text-amber">{formatINR(site.startingPrice)}</span> {site.priceNote}
        </p>
      )}
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={waLink(waMessage)} class="btn btn-wa" target="_blank" rel="noopener" data-track="whatsapp_click"><Icon name="whatsapp" /> Get best price on WhatsApp</a>
        <a href={telLink} class="btn btn-light" data-track="call_click"><Icon name="phone" /> Call {site.phone}</a>
      </div>
    </div>
  </div>

  <!-- River current lines (signature): draw in once on load -->
  <svg class="pointer-events-none absolute inset-x-0 bottom-0 h-16 w-full sm:h-24" viewBox="0 0 1440 96" preserveAspectRatio="none" aria-hidden="true">
    <path class="current-line" d="M-20 70C200 52 380 46 600 58S980 86 1200 74 1400 52 1460 56" fill="none" stroke="var(--color-amber)" stroke-opacity=".85" stroke-width="2" vector-effect="non-scaling-stroke" />
    <path class="current-line" d="M-20 80C220 64 400 60 620 70S1000 94 1220 84 1410 64 1460 67" fill="none" stroke="var(--color-sand-light)" stroke-opacity=".5" stroke-width="1.25" vector-effect="non-scaling-stroke" />
    <path class="current-line" d="M-20 89C240 76 420 73 640 81S1020 100 1240 92 1420 76 1460 78" fill="none" stroke="var(--color-sand-light)" stroke-opacity=".3" stroke-width="1" vector-effect="non-scaling-stroke" />
    <path class="current-line" d="M-20 60C180 42 360 36 580 47S960 74 1180 63 1390 42 1460 45" fill="none" stroke="var(--color-sand-light)" stroke-opacity=".22" stroke-width="1" vector-effect="non-scaling-stroke" />
  </svg>
</section>
