---
import Base from '../layouts/Base.astro';
import page from '../data/pages/wedding.json';
import { fill, shareImage } from '../lib/content';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import FeatureIcon from '../components/FeatureIcon.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { faqsByTag, faqSchema } from '../lib/schema';

const faqs = faqsByTag('wedding');
const wa = "Hi Samsaara! I'm interested in a destination wedding for ~___ guests on [date].";
const crumbs = [{ name: 'Destination Weddings', path: '/destination-wedding/' }];
const included = [
  { t: 'Venue on the Ganga', d: 'A riverside setting with the Himalayan foothills as your backdrop.' },
  { t: 'Catering included', d: 'Meals for your guests through the celebration, planned with you.' },
  { t: 'Décor included', d: 'Setups for the ceremony and functions, styled to your theme.' },
  { t: 'Guest stay', d: '17 AC cottages plus riverside tents — your guests stay together, on site.' },
  { t: 'Pre-wedding shoots', d: 'River beach, cottages and golden-hour light for your photos.' },
  { t: 'Sangeet & music', d: 'Karaoke, music and bonfire evenings for the pre-wedding fun.' },
];
const steps = [
  'Share your dates, guest count and budget on WhatsApp.',
  'We send a custom quote covering stay, catering and décor.',
  'Visit the venue (or take a video walkthrough) and finalise.',
  'Confirm with an advance — we take care of the rest.',
];
---
<Base
  title={fill(page.seo.title)}
  description={fill(page.seo.description)}
  image={shareImage(page.seo.image)}
  waMessage={wa}
  breadcrumbs={crumbs}
  schema={[faqSchema(faqs)]}
>
  <PageHero
    eyebrow={fill(page.hero.eyebrow)}
    title={fill(page.hero.title)}
    subtitle={fill(page.hero.subtitle)}
    image={page.hero.image}
    imageAlt={page.hero.alt}
    representative={page.hero.representative}
    waMessage={wa}
    crumbs={crumbs}
    showPrice={false}
  />

  <section class="section">
    <div class="container-x">
      <div class="max-w-3xl prose-s reveal">
        <h2>A small wedding venue in Uttarakhand that feels like your own</h2>
        <p>Big banquet halls aren’t for everyone. At The Samsaara, your family and friends get the whole riverside resort — cottages, tents, lawns and the Ganga beach — for an intimate wedding of <strong>70 to 100 guests</strong>. Everyone stays together on site, wakes up by the river and shares every function from haldi to pheras.</p>
        <p>Because we plan every wedding from scratch, there are no fixed packages. Tell us what you have in mind and we’ll put together a <strong>custom quote with catering and décor included</strong> — making a <strong>budget destination wedding in Rishikesh</strong> genuinely possible.</p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {included.map((i) => (
          <div class="card reveal p-6">
            <span class="grid h-11 w-11 place-items-center rounded-lg bg-teal/10 text-teal"><FeatureIcon text={i.t} class="h-6 w-6" /></span>
            <h3 class="mt-3 !text-xl">{i.t}</h3>
            <p class="mt-2 text-base text-charcoal/75">{i.d}</p>
          </div>
        ))}
      </div>

      {page.photos.length > 0 && (
        <div class="mt-10 grid gap-4 sm:grid-cols-3">
          {page.photos.map((p) => (
            <img src={p.image} alt={p.alt} loading="lazy" width="1600" height="1200" class="reveal aspect-[4/3] w-full rounded-xl object-cover" />
          ))}
        </div>
      )}

      <CtaBand title="Get a custom wedding quote" text="Share your date and guest count on WhatsApp — we’ll reply with a plan and price that covers stay, catering and décor." waMessage={wa} />

      <div class="grid gap-12 lg:grid-cols-2">
        <div class="prose-s reveal">
          <h2>Why couples choose a riverside wedding in Rishikesh</h2>
          <p><strong>It’s close to home.</strong> Shivpuri is about 6–7 hours by road from Delhi and roughly an hour from Dehradun’s Jolly Grant airport, so guests from across North India can reach you easily.</p>
          <p><strong>It’s meaningful.</strong> Getting married on the banks of the Ganga, in the yoga capital of the world, carries a spiritual weight a city venue can’t match.</p>
          <p><strong>It’s a holiday for your guests.</strong> Between functions, guests can go rafting, swim in the pool or sit around the bonfire — turning your wedding into a weekend everyone remembers.</p>
          <p><strong>It’s great value.</strong> With stay, food and décor bundled, a 70–100 guest wedding here often costs less than a comparable city banquet.</p>
        </div>
        <div class="reveal">
          <img src={page.preWeddingPhoto.image} alt={page.preWeddingPhoto.alt} loading="lazy" width="1200" height="800" class="rounded-xl" />
          <div class="prose-s mt-6">
            <h3>Pre-wedding shoots</h3>
            <p>Our river beach, cottages and the hills around Shivpuri make a beautiful pre-wedding shoot location. Book a shoot on its own, or combine it with your wedding stay. See more <a href="/blog/pre-wedding-shoot-locations-rishikesh/">pre-wedding shoot locations in Rishikesh</a>.</p>
          </div>
        </div>
      </div>

      <div class="mt-16 reveal">
        <h2>How planning works</h2>
        <ol class="relative mt-8 grid gap-7 before:absolute before:bottom-4 before:left-[17px] before:top-4 before:w-px before:bg-teal/30 before:content-[''] md:grid-cols-4 md:gap-6 md:before:bottom-auto md:before:left-0 md:before:right-0 md:before:top-[17px] md:before:h-px md:before:w-auto">
          {steps.map((s, i) => (
            <li class="relative pl-14 md:pl-0 md:pt-14">
              <span aria-hidden="true" class="absolute left-0 top-0 grid h-9 w-9 place-items-center rounded-full bg-teal-dark font-display text-sm font-bold text-amber ring-4 ring-sand-light">{i + 1}</span>
              <p class="text-base text-charcoal/85">{s}</p>
            </li>
          ))}
        </ol>
        <div class="prose-s mt-8 max-w-3xl">
          <p>Planning on a budget? Read our guide to <a href="/blog/destination-wedding-rishikesh-budget/">planning a destination wedding in Rishikesh under budget</a>. Looking for a smaller celebration? See <a href="/birthday-celebrations/">birthdays and parties</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-sand">
    <div class="container-x grid gap-12 lg:grid-cols-2">
      <FaqList items={faqs} title="Wedding FAQs" />
      <EnquiryForm defaultType="Wedding" title="Plan your wedding" />
    </div>
  </section>
</Base>
