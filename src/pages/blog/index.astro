---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ImageCard from '../../components/ImageCard.astro';
import site from '../../data/site.json';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const crumbs = [{ name: 'Travel Guides', path: '/blog/' }];
---
<Base
  title="Rishikesh Travel Guides — Rafting, Camping & Trips | The Samsaara"
  description="Practical guides to Rishikesh and Shivpuri: how to reach, rafting, camping, weekend itineraries, weddings, school trips and offsites."
  breadcrumbs={crumbs}
>
  <section class="section">
    <div class="container-x">
      <nav aria-label="Breadcrumb" class="mb-4 text-sm text-charcoal/60"><a href="/" class="text-charcoal/60">Home</a> / Travel Guides</nav>
      <h1>Rishikesh Travel Guides</h1>
      <p class="lead mt-4 max-w-2xl">Local tips from our team in Shivpuri — how to get here, when to come, and how to plan the perfect trip.</p>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((p) => (
          <ImageCard href={`/blog/${p.id}/`} image={p.data.image || site.branding.shareImage} alt={p.data.imageAlt || p.data.title} title={p.data.title} text={p.data.description} cta="Read guide" />
        ))}
      </div>
    </div>
  </section>
</Base>
