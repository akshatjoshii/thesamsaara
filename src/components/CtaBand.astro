---
import Icon from './Icon.astro';
import { waLink, telLink } from '../lib/links';
interface Props { title?: string; text?: string; waMessage?: string }
const {
  title = 'Get the best price on WhatsApp',
  text = 'Prices change with dates and group size. Message us your dates and number of guests and we’ll reply with our best offer.',
  waMessage,
} = Astro.props;
---
<div class="@container my-12">
<div class="relative overflow-hidden rounded-xl bg-teal-dark px-6 py-9 pb-12 text-sand-light @2xl:flex @2xl:items-center @2xl:justify-between @2xl:gap-8 @2xl:px-10">
  <svg class="pointer-events-none absolute inset-x-0 bottom-0 h-10 w-full" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 40C220 26 420 22 640 32S1020 56 1240 46 1400 30 1440 32" fill="none" stroke="var(--color-amber)" stroke-opacity=".7" stroke-width="1.5" vector-effect="non-scaling-stroke" />
    <path d="M0 50C240 38 440 35 660 43S1040 62 1260 54 1410 40 1440 42" fill="none" stroke="var(--color-sand-light)" stroke-opacity=".25" stroke-width="1" vector-effect="non-scaling-stroke" />
  </svg>
  <div class="relative">
    <p class="font-display text-2xl font-bold tracking-tight text-sand-light">{title}</p>
    <p class="mt-2 max-w-xl text-base text-sand-light/80">{text}</p>
  </div>
  <div class="relative mt-6 flex flex-wrap gap-3 @2xl:mt-0 @2xl:shrink-0">
    <a href={waLink(waMessage)} class="btn btn-wa" target="_blank" rel="noopener" data-track="whatsapp_click"><Icon name="whatsapp" /> WhatsApp us</a>
    <a href={telLink} class="btn btn-light" data-track="call_click"><Icon name="phone" /> Call</a>
  </div>
</div>
</div>
